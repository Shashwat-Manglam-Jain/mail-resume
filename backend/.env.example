# =============================================================================
# Email Resume Bulk Sender — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your details.
# Personal details are used to auto-generate resumes and compose emails.
# SMTP settings are used to send emails.
# =============================================================================

# ── Your Personal Details (used in resume and email signature) ──────────────
YOUR_NAME=Your Full Name
YOUR_EMAIL=you@example.com
YOUR_PHONE=+91 98765 43210
YOUR_LOCATION=City, India
YOUR_LINKEDIN=linkedin.com/in/your-profile
YOUR_GITHUB=github.com/your-username
YOUR_PORTFOLIO=yourportfolio.com
YOUR_EDUCATION=B.Tech Computer Science, Your College
YOUR_GRADUATION_YEAR=2026

# ── SMTP Configuration (for sending emails) ────────────────────────────────
# Gmail: smtp.gmail.com / 465 / use App Password (not account password)
# Outlook: smtp-mail.outlook.com / 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com


