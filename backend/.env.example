# =============================================================================
# Email Resume Bulk Sender — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your details.
# Profile data can also be managed via the Resume Builder UI (stored in DB).
# .env values serve as fallback if no DB profile exists.
# =============================================================================

# ── Your Personal Details (fallback — prefer editing via UI) ──────────────
YOUR_NAME=Your Name
YOUR_EMAIL=you@example.com
YOUR_PHONE=+91 00000 00000
YOUR_LOCATION=City, India
YOUR_LINKEDIN=linkedin.com/in/your-profile
YOUR_GITHUB=github.com/your-username
YOUR_PORTFOLIO=yourportfolio.com
YOUR_EDUCATION=B.Tech Computer Science, Your College
YOUR_GRADUATION_YEAR=2026
YOUR_EXPERIENCE_YEARS=4+

# ── Work Experience (fallback — prefer editing via UI) ────────────────────
COMPANY_1_NAME=Current Company
COMPANY_1_ROLE=Software Engineer
COMPANY_1_LOCATION=City, India
COMPANY_1_DURATION=Jan 2024 -- Present

COMPANY_2_NAME=Previous Company
COMPANY_2_ROLE=Junior Developer
COMPANY_2_LOCATION=City, India
COMPANY_2_DURATION=Jul 2022 -- Dec 2023

# ── SMTP Configuration (for sending emails) ────────────────────────────────
# Gmail: smtp.gmail.com / 465 / use App Password (not account password)
# Outlook: smtp-mail.outlook.com / 587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=you@gmail.com

# ── Neon PostgreSQL (for resume data + roles) ─────────────────────────────
NEON_DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ── Optional ──────────────────────────────────────────────────────────────
# CUSTOM_RESUME_PATH=path/to/custom_resume.pdf
# FRONTEND_URL=https://your-frontend.vercel.app
